{
  "name": "@steel-ai/dev-connector",
  "version": "0.1.0",
  "description": "Locally installed outbound connector for a developer-owned LLM and Steel AI Server",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "steel-connector": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    }
  },
  "files": [
    "dist/",
    "examples/",
    "PROTOCOL.md",
    "SECURITY.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "scripts/"
  ],
  "scripts": {
    "test": "node --test test/test_connector_protocol.mts",
    "health": "node src/cli.ts health",
    "compat": "node src/cli.ts compat",
    "build": "tsc -p tsconfig.json",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "homepage": "https://steelai.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/jordanshadowens/steel-ai.git",
    "directory": "packages/connector"
  }
}

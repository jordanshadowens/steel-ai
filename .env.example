# Hosted runtime used by the web app, workflow CLI and connector.
STEEL_RUNTIME_URL=https://api.steelai.dev

# Optional outbound connector. Use the key issued by your runtime operator.
STEEL_API_KEY=

# OpenAI-compatible provider used by the connector and local Workflow Creator AI Assist.
STEEL_PROVIDER_URL=
STEEL_PROVIDER_KEY=
STEEL_PROVIDER_MODEL=
STEEL_ALLOW_REMOTE_PROVIDER=0

# Optional workflow CLI. Use a workflow-scoped steel_dev_ key.
STEEL_AGENT_KEY=

# Local Data Designer PostgreSQL connection (server-side only).
# Install Python dependencies from apps/web/requirements-designer.txt.
DATABASE_URL=
